  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 60
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 100
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044F\u0441\u044C \u0432
    \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044E \u0432 \u0421\u043E\u043B\u0443\u043D\u0438,
    \u0410\u043D\u0434\u0440\u0435\u0439 \u0421\u0432\u043E\u0431\u043E\u0434\u0430
    - \u043C\u043E\u043B\u043E\u0434\u043E\u0439,\n\u043D\u043E \u043E\u043F\u044B\u0442\u043D\u044B\u0439
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    - \u0431\u044B\u043B \u043F\u043E\u043B\u043E\u043D \u0440\u0435\u0448\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043D\u043E\u0432\u044B\u0435 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u044B.\n\u041F\u0440\u0438\u0431\u044B\u0432
    \u0432 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E,
    \n\u0410\u043D\u0434\u0440\u0435\u0439 \u043F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C
    \n\u043E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C.
    \n\u0410\u043D\u0434\u0440\u0435\u0439 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0438\u0437\u0443\u0447\u0430\u043B \u043A\u0430\u0440\u0442\u0443, \n\u043F\u044B\u0442\u0430\u044F\u0441\u044C
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C, \u0433\u0434\u0435
    \u043C\u043E\u0433\u0443\u0442 \n\u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
    \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435 \u0448\u0430\u0445\u0442\u044B,\n
    \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0445\u043E\u0434\u0438\u043B\u0438
    \u043B\u0435\u0433\u0435\u043D\u0434\u044B. \u0415\u0433\u043E \u0432\u0437\u043E\u0440
    \u0442\u043E \n\u0438 \u0434\u0435\u043B\u043E \u0443\u0441\u0442\u0440\u0435\u043C\u043B\u044F\u043B\u0441\u044F
    \u043A \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443, \u0433\u0434\u0435
    \n\u0432\u043E\u0437\u0432\u044B\u0448\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0433\u043E\u0440\u044B, \n\u0441\u043A\u0440\u044B\u0432\u0430\u044F \u0432
    \u0441\u0432\u043E\u0438\u0445 \u043D\u0435\u0434\u0440\u0430\u0445, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u043D\u0435\u0441\u043C\u0435\u0442\u043D\u044B\u0435 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430.\r"
